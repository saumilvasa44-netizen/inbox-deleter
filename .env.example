# Reuse the SAME Google Cloud OAuth client as the expense-dashboard project
# (same Client ID/Secret) — see README.md for the extra setup this app needs
# on top of what's already configured there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXTAUTH_URL="http://localhost:3001"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
